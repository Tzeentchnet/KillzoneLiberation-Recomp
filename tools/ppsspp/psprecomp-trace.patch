+static u32 PrRecompScriptedButtons() {
+	static struct {
+		int frame;
+		u32 mask;
+		int width;
+	} events[256];
+	static int count = -1;
+	if (count < 0) {
+		count = 0;
+		const char *path = getenv("PSPRECOMP_PADSCRIPT");
+		if (path && *path) {
+			if (FILE *fp = fopen(path, "r")) {
+				unsigned mask;
+				while (count < (int)ARRAY_SIZE(events) &&
+					fscanf(fp, "%d %x %d", &events[count].frame, &mask, &events[count].width) == 3) {
+					events[count].mask = mask;
+					count++;
+				}
+				fclose(fp);
+			} else {
+				fprintf(stderr, "PSPRECOMP_PADSCRIPT: cannot open %s\n", path);
+			}
+		}
+	}
+	int frame = __DisplayGetNumVblanks();
+	u32 buttons = 0;
+	for (int i = 0; i < count; i++) {
+		if (frame >= events[i].frame && frame < events[i].frame + events[i].width)
+			buttons |= events[i].mask;
+	}
+	return buttons;
+}
