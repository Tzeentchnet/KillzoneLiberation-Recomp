+static u32 PrRecompScriptedButtons() {
+	static struct {
+		int frame;
+		u32 mask;
+		int width;
+	} events[256];
+	static int count = -1;
+	if (count < 0) {
+		count = 0;
+		const char *path = getenv("PSPRECOMP_PADSCRIPT");
+		if (path && *path) {
+			if (FILE *fp = fopen(path, "r")) {
+				char line[160];
+				while (count < (int)ARRAY_SIZE(events) && fgets(line, sizeof(line), fp)) {
+					int ppssppFrame, runtimePresent, ppssppWidth, runtimeWidth;
+					unsigned mask;
+					char extra;
+					char *p = line;
+					while (*p == ' ' || *p == '\t')
+						++p;
+					if (!*p || *p == '#' || *p == '\r' || *p == '\n')
+						continue;
+					if (sscanf(p, "%d %d %x %d %d %c", &ppssppFrame, &runtimePresent,
+							&mask, &ppssppWidth, &runtimeWidth, &extra) == 5) {
+						events[count].frame = ppssppFrame;
+						events[count].mask = mask;
+						events[count].width = ppssppWidth;
+						++count;
+					} else if (sscanf(p, "%d %x %d %c", &ppssppFrame, &mask,
+							&ppssppWidth, &extra) == 3) {
+						events[count].frame = ppssppFrame;
+						events[count].mask = mask;
+						events[count].width = ppssppWidth;
+						++count;
+					} else {
+						fprintf(stderr, "PSPRECOMP_PADSCRIPT: malformed line: %s", line);
+						fclose(fp);
+						exit(2);
+					}
+				}
+				fclose(fp);
+			} else {
+				fprintf(stderr, "PSPRECOMP_PADSCRIPT: cannot open %s\n", path);
+				exit(2);
+			}
+		}
+	}
+	int frame = __DisplayGetNumVblanks();
+	u32 buttons = 0;
+	for (int i = 0; i < count; i++) {
+		if (frame >= events[i].frame && frame < events[i].frame + events[i].width)
+			buttons |= events[i].mask;
+	}
+	return buttons;
+}
