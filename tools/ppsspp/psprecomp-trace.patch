+class GoldenFrameCapture {
+public:
+	bool Init() {
+		const char *manifest = getenv("PSPRECOMP_CAPTURE_MANIFEST");
+		if (!manifest || !manifest[0])
+			return true;
+		const char *outputDir = getenv("PSPRECOMP_CAPTURE_DIR");
+		if (!outputDir || !outputDir[0])
+			return Fail("PSPRECOMP_CAPTURE_DIR is required");
+		outputDir_ = outputDir;
+
+		FILE *file = fopen(manifest, "rb");
+		if (!file)
+			return Fail("cannot open manifest", manifest);
+		char line[256];
+		int lineNumber = 0;
+		bool seenHeader = false;
+		u32 previousRuntimePresent = 0;
+		while (fgets(line, sizeof(line), file)) {
+			++lineNumber;
+			char *p = line;
+			while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n')
+				++p;
+			if (!*p)
+				continue;
+			if (*p == '#') {
+				if (!strcmp(p, "# psp-recomp golden frames v2\n") ||
+					!strcmp(p, "# psp-recomp golden frames v2\r\n"))
+					seenHeader = true;
+				continue;
+			}
+
+			Request request{};
+			u32 runtimePresent = 0;
+			char scene[32]{};
+			char extra = 0;
+			if (sscanf(p, "%u %u %63s %31s %c",
+					&request.present, &runtimePresent, request.name, scene, &extra) != 4) {
+				fclose(file);
+				return FailLine("malformed manifest", lineNumber);
+			}
+			if (requestCount_ >= FRAME_COUNT || request.present == 0 ||
+				runtimePresent == 0 ||
+				(requestCount_ && request.present <= requests_[requestCount_ - 1].present) ||
+				(requestCount_ && runtimePresent <= previousRuntimePresent) ||
+				strchr(request.name, '/') || strchr(request.name, '\\')) {
+				fclose(file);
+				return FailLine("invalid capture request", lineNumber);
+			}
+			size_t nameLength = strlen(request.name);
+			if (nameLength < 5 || strcmp(request.name + nameLength - 4, ".ppm")) {
+				fclose(file);
+				return FailLine("capture name must end in .ppm", lineNumber);
+			}
+			for (int i = 0; i < requestCount_; ++i) {
+				if (!strcmp(request.name, requests_[i].name)) {
+					fclose(file);
+					return FailLine("duplicate capture name", lineNumber);
+				}
+			}
+			requests_[requestCount_++] = request;
+			previousRuntimePresent = runtimePresent;
+		}
+		if (ferror(file)) {
+			fclose(file);
+			return Fail("cannot read manifest", manifest);
+		}
+		fclose(file);
+		if (!seenHeader || requestCount_ != FRAME_COUNT)
+			return Fail("manifest must contain its v2 header and exactly 50 frames", manifest);
+		enabled_ = true;
+		fprintf(stderr, "golden-frame capture: loaded %d requests from %s\n", requestCount_, manifest);
+		return true;
+	}
+
+	bool Present() {
+		if (!enabled_)
+			return true;
+		++presentCount_;
+		if (nextRequest_ >= requestCount_ || presentCount_ < requests_[nextRequest_].present)
+			return true;
+		const Request &request = requests_[nextRequest_];
+		if (presentCount_ != request.present)
+			return Fail("PPSSPP skipped a requested presented frame", request.name);
+		if (!gpuDebug)
+			return Fail("GPU debug interface is unavailable");
+
+		GPUDebugBuffer buffer;
+		if (!gpuDebug->GetCurrentFramebuffer(buffer, GPU_DBG_FRAMEBUF_DISPLAY))
+			return Fail("cannot read the current display framebuffer", request.name);
+		const std::vector<u32> pixels = TranslateDebugBufferToCompare(&buffer, STRIDE, HEIGHT);
+		if (pixels.size() != STRIDE * HEIGHT)
+			return Fail("cannot convert the display framebuffer", request.name);
+
+		const std::string path = outputDir_ + "/" + request.name;
+		FILE *file = fopen(path.c_str(), "wb");
+		if (!file)
+			return Fail("cannot open capture output", path.c_str());
+		bool writeFailed = fprintf(file, "P6\n%u %u\n255\n", WIDTH, HEIGHT) < 0;
+		for (u32 y = 0; y < HEIGHT && !writeFailed; ++y) {
+			const u32 sourceY = HEIGHT - 1 - y;
+			for (u32 x = 0; x < WIDTH; ++x) {
+				const u32 pixel = pixels[sourceY * STRIDE + x];
+				const u8 rgb[3] = {
+					(u8)(pixel >> 16),
+					(u8)(pixel >> 8),
+					(u8)pixel,
+				};
+				if (fwrite(rgb, 1, sizeof(rgb), file) != sizeof(rgb)) {
+					writeFailed = true;
+					break;
+				}
+			}
+		}
+		if (fclose(file) != 0)
+			writeFailed = true;
+		if (writeFailed)
+			return Fail("cannot write capture output", path.c_str());
+		fprintf(stderr, "golden-frame capture: present %u -> %s\n", presentCount_, path.c_str());
+
+		++nextRequest_;
